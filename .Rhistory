vr_data$case_number <= as.POSIXct("2021-12-31 23:59:59"), ]
# Filter for a range
vr_subset <- vr_sf[vr_sf$case_number >= as.POSIXct("2021-01-01 00:00:00") &
vr_sf$case_number <= as.POSIXct("2021-12-31 23:59:59"), ]
